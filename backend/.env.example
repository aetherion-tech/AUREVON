# Copy this file to .env. Leave Kite values blank until you have your own app.
APP_NAME=AUREVON
LOG_LEVEL=INFO
# Generate locally: uv run python -m app.tools.dashboard_password
# Store only the Argon2 hash. Empty disables dashboard login (fails closed).
DASHBOARD_PASSWORD_HASH=
DASHBOARD_SESSION_SECONDS=28800
DASHBOARD_LOCKOUT_SECONDS=900
# Exact HTTPS development origins; no wildcard. Same-origin is always supported.
DASHBOARD_ORIGINS=["https://localhost:5173","https://127.0.0.1:5173"]
# Optional compiled frontend, served on /dashboard with API/WS on the same origin.
# DASHBOARD_FRONTEND_DIR=D:/path/to/frontend/dist
# Replay is disabled by default and cannot run alongside the managed feed.
DEVELOPMENT_REPLAY_ENABLED=false
DEVELOPMENT_REPLAY_MAX_BYTES=20000000
KITE_API_KEY=
KITE_API_SECRET=
# Use a real brick close from your TradingView chart before enabling --stream.
RENKO_BOX=50
RENKO_MODE=minute_close
# RENKO_ANCHOR=your_chart_brick_close
# Managed warm-up/recovery policy; the standalone monitor remains diagnostic.
WARMUP_LOOKBACK_TRADING_DAYS=20
RECOVERY_MAX_GAP_DAYS=30
RECOVERY_MAX_ATTEMPTS=5
RECOVERY_BACKOFF_SECONDS=1
RECOVERY_BACKOFF_MAX_SECONDS=30
READINESS_ENTRY_DELAY_SECONDS=60

# Opt-in owned data service; managed paper execution remains inactive.
MARKET_SERVICE_ENABLED=false
# After wallet migrations/integration, the running owner can audit at 15:35 IST.
WALLET_RECONCILIATION_ENABLED=false
MARKET_POLL_SECONDS=5
MARKET_STREAM=NIFTY-paper
# Defaults: app/market/calendars, data/ticks and data/market-worker.lock under backend.
# MARKET_CALENDAR_DIR=...
# MARKET_RECORD_DIR=...
# MARKET_LOCK_FILE=...
