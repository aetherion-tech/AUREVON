# Copy this file to .env. Leave Kite values blank until you have your own app.
APP_NAME=AUREVON
LOG_LEVEL=INFO
KITE_API_KEY=
KITE_API_SECRET=
# Use a real brick close from your TradingView chart before enabling --stream.
RENKO_BOX=50
RENKO_MODE=minute_close
# RENKO_ANCHOR=your_chart_brick_close
# Policy for future managed warm-up/recovery; not wired into the monitor yet.
WARMUP_LOOKBACK_TRADING_DAYS=20
RECOVERY_MAX_GAP_DAYS=30
RECOVERY_MAX_ATTEMPTS=5
RECOVERY_BACKOFF_SECONDS=1
RECOVERY_BACKOFF_MAX_SECONDS=30
READINESS_ENTRY_DELAY_SECONDS=60
