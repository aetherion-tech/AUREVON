        "properties": {
          "version": {
            "const": 1,
            "default": 1,
            "title": "Version",
            "type": "integer"
          },
          "identity": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Identity",
            "type": "string"
          },
          "effective_from": {
            "format": "date",
