            "le": 100,
            "max_digits": 24,
            "title": "Exchange Pct",
            "type": "string"
          },
          "sebi_pct": {
            "decimal_places": 6,
            "default": "0",
            "ge": 0,
            "le": 100,
            "max_digits": 24,
            "title": "Sebi Pct",
            "type": "string"
          },
          "ipft_pct": {
            "decimal_places": 6,
            "default": "0",
            "ge": 0,
            "le": 100,
            "max_digits": 24,
            "title": "Ipft Pct",
            "type": "string"
          },
          "stt_sell_pct": {
            "decimal_places": 6,
            "default": "0",
            "ge": 0,
            "le": 100,
            "max_digits": 24,
            "title": "Stt Sell Pct",
            "type": "string"
          },
          "stamp_buy_pct": {
            "decimal_places": 6,
            "default": "0",
            "ge": 0,
            "le": 100,
            "max_digits": 24,
            "title": "Stamp Buy Pct",
            "type": "string"
          },
          "gst_pct": {
            "decimal_places": 6,
            "default": "0",
            "ge": 0,
            "le": 100,
            "max_digits": 24,
            "title": "Gst Pct",
            "type": "string"
          },
          "gst_on_ipft": {
            "default": false,
            "title": "Gst On Ipft",
